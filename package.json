{
  "name": "@aklinker1/zero-zip",
  "version": "1.0.0",
  "description": "Zero dependency, tiny util for creating ZIP files",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "check": "bun run build && check",
    "build": "tsdown index.ts --minify",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@aklinker1/check": "^2.4.0",
    "@types/bun": "^1.3.14",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
